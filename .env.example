# ── Supabase (legacy — storefront uses api-server, not Supabase directly) ──────
# These are kept for any residual TanStack Start integrations scaffolded by the framework.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_key
VITE_SUPABASE_PROJECT_ID=your_supabase_project_id

# ── API Server ─────────────────────────────────────────────────────────────────
# Base URL of your api-server — no trailing slash, include /api path
# Development:  http://localhost:3000/api
# Production:   https://api.kiosk.store/api   (or your Railway domain)
VITE_API_BASE=http://localhost:3000/api

# Payment gateway PUBLIC keys (safe to expose — used in browser to launch checkout popup)
VITE_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_flutterwave_public_key
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ── Vendor ─────────────────────────────────────────────────────────────────────
# The UUID of the merchant this storefront belongs to.
# Find it in Supabase: open the users table, copy the id of the merchant's row.
# Optional in production — vendor ID is resolved automatically from /@username in buyer flow.
# Only set this for local testing of /checkout without visiting /@username first.
VITE_VENDOR_ID=
