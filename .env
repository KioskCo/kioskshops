# Backend API base URL — your api-server (e.g. http://localhost:3000/api in dev, https://api.kiosk.store/api in prod)
VITE_API_BASE="https://kioskbknd-production.up.railway.app/api"

# Payment gateway PUBLIC keys (safe to expose — used in browser to launch checkout popup)
# Get from: dashboard.flutterwave.com → Settings → APIs
VITE_FLUTTERWAVE_PUBLIC_KEY="FLWPUBK_TEST-c5b7fa5052c0aa881e1773fae2c4d342-X"
# Get from: dashboard.paystack.com → Settings → API Keys
VITE_PAYSTACK_PUBLIC_KEY="pk_test_9e10806c6a0d4a77fa081f7ec3f39b49469dd3aa"

# Vendor ID — only needed if you're testing /checkout directly without going via /@username.
# In normal buyer flow: /@username sets this automatically via sessionStorage.
# Optional: leave blank for multi-vendor production deployment.
VITE_VENDOR_ID=""
